<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Zero margins and dpi 96 leave the sheet template in charge of the whole
         A4 page, so a millimetre in the CSS is a millimetre on the paper. Smart
         shrinking has to be off: it scales the page to fit whatever wkhtmltopdf
         thinks the content width is, which silently shrinks the label grid. -->
    <record id="paperformat_stock_qr_label_a4" model="report.paperformat">
        <field name="name">Stock QR label sheet (A4)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True" />
        <field name="dpi">96</field>
    </record>
</odoo>
