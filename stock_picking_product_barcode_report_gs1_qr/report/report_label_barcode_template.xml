<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_label_barcode_gs1_qr"
        inherit_id="stock_picking_product_barcode_report.report_label_barcode"
    >
        <!-- Inserted after the GS1-128 branch so that it becomes the t-elif of
             that t-if, ahead of the t-else that renders a plain product barcode. -->
        <xpath
            expr="//t[@t-if=&quot;doc.wizard_id.barcode_format == 'gs1_128'&quot;]"
            position="after"
        >
            <t t-elif="doc.wizard_id.barcode_format == 'gs1_qr'">
                <!-- Nothing to identify the stock by means no symbol, rather than
                     one encoding a payload no scanner can resolve. -->
                <t t-if="doc.gs1_qr_value">
                    <!-- Inlined as a data URI by the barcode widget: an <img>
                         pointing at /report/barcode makes wkhtmltopdf fetch it
                         over HTTP, which fails silently and prints the alt text.
                         quiet=0 keeps reportlab's barBorder at 4 modules, and a
                         QR code without its quiet zone does not decode. -->
                    <span
                        t-out="doc.gs1_qr_value"
                        t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 256, 'height': 256, 'quiet': 0, 'img_style': 'width:16mm;height:16mm;'}"
                    />
                    <br />
                    <span t-esc="doc.gs1_qr_hri" style="font-size: 6px;" />
                </t>
            </t>
        </xpath>
    </template>
</odoo>
