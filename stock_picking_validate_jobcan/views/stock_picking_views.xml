<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <sheet position="before">
                <div
                    class="alert alert-danger"
                    role="alert"
                    attrs="{'invisible': [('warning_message', '=', False)]}"
                >
                    <field name="warning_message" class="oe_inline" />
                </div>
            </sheet>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="show_jobcan_wf_number" invisible="1" />
                <field
                    name="jobcan_wf_number"
                    attrs="{'invisible': [('show_jobcan_wf_number', '=', False)], 'required': [('show_jobcan_wf_number', '=', True)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
