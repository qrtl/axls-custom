<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_barcodes_read_inventory_form" model="ir.ui.view">
        <field name="name">stock.barcodes.read.inventory.form</field>
        <field name="model">wiz.stock.barcodes.read.inventory</field>
        <field
            name="inherit_id"
            ref="stock_barcodes.view_stock_barcodes_read_inventory_form"
        />
        <field name="arch" type="xml">
            <!-- Inventory adjustments are applied from the Inventory backend once the
                 counted quantities have been reviewed, not from the barcode interface.
                 A static invisible takes precedence over the button's own attrs
                 domain, so the button is hidden in every state. -->
            <xpath expr="//button[@name='apply_inventory']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
