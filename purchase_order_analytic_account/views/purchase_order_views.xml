<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_order_view_tree" model="ir.ui.view">
        <field name="name">purchase.order.tree (purchase_order_analytic_account)</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree" />
        <field name="arch" type="xml">
            <field name="origin" position="before">
                <field
                    name="analytic_account_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    optional="show"
                    groups="analytic.group_analytic_accounting"
                />
            </field>
        </field>
    </record>
    <record id="purchase_order_view_tree_kpis" model="ir.ui.view">
        <field
            name="name"
        >purchase.order.kpis.tree (purchase_order_analytic_account)</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree" />
        <field name="arch" type="xml">
            <field name="origin" position="before">
                <field
                    name="analytic_account_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    optional="show"
                    groups="analytic.group_analytic_accounting"
                />
            </field>
        </field>
    </record>
    <record id="purchase_order_view_search" model="ir.ui.view">
        <field
            name="name"
        >purchase.order.search (purchase_order_analytic_account)</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field
                    name="analytic_account_ids"
                    groups="analytic.group_analytic_accounting"
                />
            </field>
        </field>
    </record>
</odoo>
