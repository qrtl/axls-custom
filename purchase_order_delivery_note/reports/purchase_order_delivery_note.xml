<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_order_delivery_note" model="ir.actions.report">
        <field name="name">Purchase Order Delivery Note</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >purchase_order_delivery_note.report_purchase_order_delivery</field>
        <field
            name="report_file"
        >purchase_order_delivery_note.report_purchase_order_delivery</field>
        <field
            name="print_report_name"
        >'Purchase Delivery Note - %s - %s' % (object.partner_id.name or '', object.name)</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order" />
        <field name="binding_type">report</field>
    </record>
</odoo>
