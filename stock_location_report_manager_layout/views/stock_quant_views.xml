<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_quant_tree_readonly_manager_layout" model="ir.ui.view">
        <field name="name">stock.quant.list.readonly.manager</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="edit">0</attribute>
                <attribute name="delete">0</attribute>
                <attribute name="editable" />
            </xpath>
            <xpath
                expr="//field[@name='inventory_quantity_auto_apply']"
                position="replace"
            >
                <field name="quantity" string="On Hand Quantity" sum="Total On Hand" />
            </xpath>
        </field>
    </record>
</odoo>
