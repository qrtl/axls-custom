<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_analytic_category_form_view" model="ir.ui.view">
        <field name="name">account.analytic.category.form</field>
        <field name="model">account.analytic.category</field>
        <field name="arch" type="xml">
            <form string="Analytic Plans">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <field name="active" invisible="1" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="account_analytic_category_tree_view" model="ir.ui.view">
        <field name="name">account.analytic.category.tree</field>
        <field name="model">account.analytic.category</field>
        <field name="arch" type="xml">
            <tree create="1">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>
    <record id="account_analytic_category_action" model="ir.actions.act_window">
        <field name="name">Analytic Categories</field>
        <field name="res_model">account.analytic.category</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
        id="account_analytic_category_menu"
        name="Analytic Categories"
        parent="account.menu_analytic_accounting"
        action="account_analytic_category.account_analytic_category_action"
        groups="analytic.group_analytic_accounting"
        sequence="10"
    />
</odoo>
