<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_budget_line_search" model="ir.ui.view">
        <field name="name">purchase.budget.line.search</field>
        <field name="model">purchase.budget.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="budget_code_id" />
                <field name="partner_id" />
                <field name="product_id" />
                <field name="order_line_id" />
                <filter
                    name="order_state_draft"
                    string="RFQ"
                    domain="[('order_state','=','draft')]"
                />
                <filter
                    name="order_state_sent"
                    string="RFQ Sent"
                    domain="[('order_state','=','sent')]"
                />
                <filter
                    name="order_state_to_approve"
                    string="To Approve"
                    domain="[('order_state','=','to_approve')]"
                />
                <filter
                    name="order_state_purchase"
                    string="Purchase Order"
                    domain="[('order_state','=','purchase')]"
                />
                <filter
                    name="order_state_done"
                    string="Locked"
                    domain="[('order_state','=','done')]"
                />
                <filter
                    name="order_state_cancel"
                    string="Cancelled"
                    domain="[('order_state','=','cancel')]"
                />
                <separator />
                <filter name="date_order" string="Order Date" date="date_order" />
                <separator />
                <filter name="date_planned" string="Planned Date" date="date_planned" />
                <group expand="1" string="Group By">
                    <filter
                        string="Budget Code"
                        name="group_by_budget_code"
                        context="{'group_by':'budget_code_id'}"
                    />
                    <filter
                        string="Partner"
                        name="group_by_partner_id"
                        context="{'group_by':'partner_id'}"
                    />
                    <filter
                        string="Product"
                        name="group_by_product_id"
                        context="{'group_by':'product_id'}"
                    />
                    <filter
                        string="Order"
                        name="group_by_order_id"
                        context="{'group_by':'order_id'}"
                    />
                    <filter
                        name="groupby_date_order"
                        string="Order Date"
                        context="{'group_by':'date_order'}"
                    />
                    <filter
                        name="groupby_date_planned"
                        string="Planned Date"
                        context="{'group_by':'date_planned'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="view_purchase_budget_line_tree" model="ir.ui.view">
        <field name="name">purchase.budget.line.tree</field>
        <field name="model">purchase.budget.line</field>
        <field name="arch" type="xml">
            <tree editable="top" create="0" multi_edit="1">
                <field name="order_id" />
                <field name="product_id" optional="show" />
                <field name="order_line_id" optional="hide" />
                <field name="budget_code_id" domain="[('child_ids','=',False)]" />
                <field name="partner_id" optional="show" />
                <field name="quantity" />
                <field name="purchase_price_unit" optional="show" />
                <field name="budget_price_unit" />
                <field name="currency_id" invisible="1" />
                <field name="price_total" />
                <field name="date_order" widget="date" />
                <field name="date_planned" widget="date" />
                <field
                    name="order_state"
                    optional="show"
                    widget="badge"
                    decoration-success="order_state == 'purchase' or order_state == 'done'"
                    decoration-warning="order_state == 'to approve'"
                    decoration-info="order_state == 'draft' or order_state == 'sent'"
                />
                <field name="invoice_ids" widget="many2many_tags" />
            </tree>
        </field>
    </record>
    <record id="action_purchase_budget_line" model="ir.actions.act_window">
        <field name="name">Purchase Budget Lines</field>
        <field name="res_model">purchase.budget.line</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_purchase_budget_line_search" />
        <field name="context">{}</field>
    </record>
    <menuitem
        id="purchase_budget_line_menu"
        name="Purchase Budget Lines"
        action="action_purchase_budget_line"
        parent="purchase.menu_procurement_management"
        sequence="7"
    />
</odoo>
