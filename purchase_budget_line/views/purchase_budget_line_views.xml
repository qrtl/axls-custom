<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_budget_line_search" model="ir.ui.view">
        <field name="name">purchase.budget.line.search</field>
        <field name="model">purchase.budget.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_line_id" />
                <field name="code" />
                <group expand="1" string="Group By">
                    <filter
                        string="Purchase Order Line"
                        name="group_by_order_line_id"
                        context="{'group_by':'order_line_id'}"
                    />
                    <filter
                        string="Code"
                        name="group_by_code"
                        context="{'group_by':'code'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="view_purchase_budget_line_tree" model="ir.ui.view">
        <field name="name">purchase.budget.line.tree</field>
        <field name="model">purchase.budget.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="order_line_id" />
                <field name="code" />
                <field name="quantity" />
                <field name="purchase_order_line_price" />
                <field name="budget_price_unit" />
                <field name="currency_id" invisible="1" />
                <field name="price_total" />
            </tree>
        </field>
    </record>
    <record id="action_purchase_budget_line" model="ir.actions.act_window">
        <field name="name">Purchase Budget Lines</field>
        <field name="res_model">purchase.budget.line</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_purchase_budget_line_search" />
        <field name="context">{}</field>
    </record>
    <menuitem
        id="purchase_budget_line_menu"
        name="Purchase Budget Lines"
        action="action_purchase_budget_line"
        parent="purchase.menu_procurement_management"
        sequence="7"
    />
</odoo>
