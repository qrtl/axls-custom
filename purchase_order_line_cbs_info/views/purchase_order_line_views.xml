<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_order_line_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']//tree//field[@name='price_unit']"
                position="after"
            >
                <field name="cbs_info_codes" optional="hide" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']//tree//field[@name='price_subtotal']"
                position="after"
            >
                <button
                    name="action_show_cbs_infos"
                    type="object"
                    icon="fa-list"
                    width="0.1"
                    title="CBS Infos"
                />
            </xpath>
        </field>
    </record>
    <record id="view_purchase_order_line_cbs_info_form" model="ir.ui.view">
        <field name="name">purchase.order.line.cbs.info.form</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="product_id" readonly="1" />
                        <field name="product_uom_qty" readonly="1" />
                    </group>
                    <field name="cbs_info_ids">
                        <tree editable="bottom">
                            <field name="code" />
                            <field name="quantity" />
                            <field name="purchase_order_line_price" />
                            <field name="cbs_price_unit" />
                            <field name="currency_id" invisible="1" />
                            <field name="price_total" />
                        </tree>
                    </field>
                </group>
            </form>
        </field>
    </record>
</odoo>
