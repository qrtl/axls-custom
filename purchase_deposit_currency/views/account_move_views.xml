<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_company_amount" model="ir.ui.view">
        <field name="name">account.move.form.company.amount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']" position="after">
                <field name="is_deposit_line" invisible="1"/>
                <field
                    name="company_amount"
                    optional="hide"
                    attrs="{'column_invisible': [('parent.move_type', 'not in', ('in_invoice', 'in_refund'))],
                            'readonly': [('is_deposit_line', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
