<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_infos']" position="before">
                <field name="price_variance_threshold" invisible="1" />
                <group
                    string="Price Discrepancy Settings"
                    attrs="{'invisible': [('price_variance_threshold', '=', False)]}"
                >
                    <field
                        name="bypass_price_variance_check"
                        attrs="{'readonly': [('state', 'in', ('done','cancel'))]}"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
