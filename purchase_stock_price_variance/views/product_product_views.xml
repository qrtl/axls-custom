<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_normal_form_view_inherit" model="ir.ui.view">
        <field name="name">product.product.form.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='traceability']" position="after">
                <group string="Price Discrepancy Settings" name="price_discrepancy">
                    <field name="price_variance_threshold_percent" />
                    <field name="price_variance_threshold_amount" />
                    <field name="bypass_price_variance_check" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
