<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='traceability']" position="after">
                <group string="Price Discrepancy Settings" name="price_discrepancy">
                    <field name="bypass_price_variance_check" />
                    <field
                        name="price_variance_threshold_percent"
                        attrs="{'invisible': [('bypass_price_variance_check', '=', True)]}"
                    />
                    <field
                        name="price_variance_threshold_amount"
                        attrs="{'invisible': [('bypass_price_variance_check', '=', True)]}"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
