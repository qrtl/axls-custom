<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_id']" position="attributes">
                <attribute name="widget">selection</attribute>
            </xpath>
            <xpath
                expr="//field[@name='move_ids_without_package']/tree//field[@name='lot_ids']"
                position="attributes"
            >
                <attribute name="string">Lots/Serials</attribute>
                <!-- Show lot_ids for both 'lot' and 'serial' tracking (hide only for 'none') -->
                <attribute name="attrs">
                    {'invisible': ['|', ('show_details_visible', '=', False), ('has_tracking', '=', 'none')]}
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
