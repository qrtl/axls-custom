<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_separate_valuation" model="ir.ui.view">
        <field name="name">purchase.order.form.separate.valuation</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="sep_val_grni_adjustment_move_id" invisible="1"/>
                <button
                    name="action_view_sep_val_grni_adjustment"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-balance-scale"
                    attrs="{'invisible': [('sep_val_grni_adjustment_move_id', '=', False)]}"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">GRNI</span>
                        <span class="o_stat_text">Adjustment</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//group[@name='invoice_info']" position="inside">
                <field name="use_separate_valuation"/>
            </xpath>
        </field>
    </record>
</odoo>
