<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="stock_valuation_layer_search_inherit_stock_valuation_layer_reporting"
        model="ir.ui.view"
    >
        <field name="name">stock.valuation.layer.search.svl.reporting</field>
        <field name="model">stock.valuation.layer</field>
        <field name="inherit_id" ref="stock_account.view_inventory_valuation_search" />
        <field name="arch" type="xml">
            <filter name="has_remaining_qty" position="after">
                <filter
                    string="Report Category Manually Modified"
                    name="report_category_manually_modified"
                    domain="[('report_category_manually_modified', '=', True)]"
                />
            </filter>
        </field>
    </record>
    <record
        id="stock_valuation_layer_tree_inherit_stock_valuation_layer_reporting"
        model="ir.ui.view"
    >
        <field name="name">stock.valuation.layer.tree.svl.reporting</field>
        <field name="model">stock.valuation.layer</field>
        <field name="inherit_id" ref="stock_account.stock_valuation_layer_tree" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="report_category_manually_modified" invisible="1" />
                <field
                    name="report_category_id"
                    groups="stock.group_stock_manager"
                    optional="hide"
                    decoration-info="report_category_manually_modified"
                />
            </field>
        </field>
    </record>
    <record
        id="stock_valuation_layer_form_inherit_stock_valuation_layer_reporting"
        model="ir.ui.view"
    >
        <field name="name">stock.valuation.layer.form.svl.reporting</field>
        <field name="model">stock.valuation.layer</field>
        <field name="inherit_id" ref="stock_account.stock_valuation_layer_form" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="report_category_id" groups="stock.group_stock_manager" />
            </field>
        </field>
    </record>
    <record
        id="stock_valuation_layer_recompute_report_category_action"
        model="ir.actions.server"
    >
        <field name="name">Recompute Report Categories</field>
        <field name="model_id" ref="stock_account.model_stock_valuation_layer" />
        <field
            name="binding_model_id"
            ref="stock_account.model_stock_valuation_layer"
        />
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">records.assign_report_category()</field>
    </record>
</odoo>
