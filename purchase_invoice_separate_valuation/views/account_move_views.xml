<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Final Invoice field to Account Move form -->
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit.final.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="is_final_invoice" attrs="{'invisible': [('move_type', 'not in', ['in_invoice', 'in_refund'])]}"/>
                <field name="price_adjustment_move_id" attrs="{'invisible': [('price_adjustment_move_id', '=', False)]}" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Add Final Invoice field to tree view for better visibility -->
    <record id="view_in_invoice_tree_inherit" model="ir.ui.view">
        <field name="name">account.invoice.supplier.tree.inherit.final.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="is_final_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>