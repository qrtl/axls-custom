<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Separate Valuation settings into the existing Vendor Bills section -->
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.price.adjustment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='account_vendor_bills']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="purchase_price_adjustment_account_id"/>
                        <div class="text-muted">
                            Account used for price difference adjustments when posting final vendor bills
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field name="purchase_price_adjustment_account_id"
                                       class="oe_inline"
                                       options="{'no_create': True}"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="purchase_grni_adjustment_journal_id"/>
                        <div class="text-muted">
                            Journal for GRNI balancing entries (general/miscellaneous journal)
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field name="purchase_grni_adjustment_journal_id"
                                       class="oe_inline"
                                       options="{'no_create': True}"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>