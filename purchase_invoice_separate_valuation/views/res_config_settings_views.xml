<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Purchase Price Adjustment settings to Accounting Configuration -->
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.price.adjustment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Purchase Invoice Separate Valuation" string="Purchase Invoice Separate Valuation" data-key="purchase_invoice_separate_valuation">
                    <h2>Purchase Invoice Separate Valuation</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="purchase_price_adjustment_account_id"/>
                                <div class="text-muted">
                                    Account used for price difference adjustments when posting final vendor bills
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="purchase_price_adjustment_account_id" 
                                               class="oe_inline"
                                               options="{'no_create': True}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>