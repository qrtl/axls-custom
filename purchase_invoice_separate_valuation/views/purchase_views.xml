<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order form: add Advanced Invoice button, mode badge, and new fields -->
    <record id="view_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.invoice.wizard</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Hide standard Create Bill buttons when separate valuation is active -->
            <xpath expr="(//button[@name='action_create_invoice'])[1]" position="attributes">
                <attribute name="attrs">{'invisible': ['|', '|', ('state', 'not in', ('purchase', 'done')), ('invoice_status', 'in', ('no', 'invoiced')), ('use_separate_valuation', '=', True)]}</attribute>
            </xpath>
            <xpath expr="(//button[@name='action_create_invoice'])[2]" position="attributes">
                <attribute name="attrs">{'invisible': ['|', '|', '|', ('state', 'not in', ('purchase', 'done')), ('invoice_status', 'not in', ('no', 'invoiced')), ('order_line', '=', []), ('use_separate_valuation', '=', True)]}</attribute>
            </xpath>

            <!-- Advanced invoice button next to the standard one.
                 Hidden when regular invoices already exist (use_separate_valuation=False and invoice_count>0). -->
            <xpath expr="(//button[@name='action_create_invoice'])[1]" position="after">
                <button name="%(action_purchase_make_invoice_advance)d"
                        type="action"
                        string="Create Invoice (Advanced)"
                        class="btn-secondary"
                        attrs="{'invisible': ['|', '|',
                                    ('state', 'not in', ['purchase', 'done']),
                                    ('has_final_invoice', '=', True),
                                    '&amp;', ('use_separate_valuation', '=', False), ('invoice_count', '>', 0)]}"/>
            </xpath>

            <!-- Separate Valuation Mode indicator banner -->
            <xpath expr="//sheet" position="before">
                <div attrs="{'invisible': [('use_separate_valuation', '=', False)]}"
                     class="alert alert-info mb-0" role="alert">
                    <strong>Separate Valuation Mode:</strong>
                    Use <em>Create Invoice (Advanced)</em> to add invoices.
                    The standard "Create Invoice" button is blocked for this order.
                </div>
            </xpath>

            <!-- Amount totals: invoiced / remaining -->
            <xpath expr="//field[@name='tax_totals']" position="after">
                <field name="amount_invoiced" readonly="1"/>
                <field name="amount_to_invoice" readonly="1"/>
                <field name="use_separate_valuation" invisible="1"/>
                <field name="has_final_invoice" invisible="1"/>
                <field name="price_diff_reason"
                       attrs="{'invisible': [('use_separate_valuation', '=', False)]}"
                       placeholder="Reason for price difference between receipt and invoices…"/>
            </xpath>

            <!-- Order lines: invoiced / remaining columns -->
            <xpath expr="//field[@name='order_line']/tree//field[@name='price_subtotal']"
                   position="after">
                <field name="amount_invoiced" readonly="1" optional="show"/>
                <field name="amount_to_invoice" readonly="1" optional="show"/>
            </xpath>

        </field>
    </record>

    <!-- Wizard action (button target) -->
    <record id="action_purchase_make_invoice_advance" model="ir.actions.act_window">
        <field name="name">Create Invoice (Advanced)</field>
        <field name="res_model">purchase.make_invoice_advance</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
