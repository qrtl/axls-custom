<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_move_view_form" model="ir.ui.view">
        <field name="name">account.move.view.form.company.amount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="is_deposit" invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']"
                position="after"
            >
                <!-- Only a deposit bill can carry the override, so the column is
                     not shown anywhere else. -->
                <field name="company_amount_allowed" invisible="1" />
                <field
                    name="company_amount"
                    optional="hide"
                    attrs="{'column_invisible': [('parent.is_deposit', '=', False)], 'readonly': [('company_amount_allowed', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
