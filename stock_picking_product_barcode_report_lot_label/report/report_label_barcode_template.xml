<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_label_barcode_lot_barcode"
        inherit_id="stock_picking_product_barcode_report.report_label_barcode"
    >
        <!-- The anchor sits in the non-GS1 branch on purpose: a GS1 barcode
             already carries the lot in application identifier (10), so adding a
             second symbol there would only duplicate it. -->
        <xpath expr="//span[@t-esc='doc.product_id.barcode']" position="after">
            <t t-if="doc.lot_id">
                <br />
                <!-- The widget takes the lot name as data and inlines the symbol
                     as a data URI. Splicing it into a /report/barcode URL breaks
                     on any lot name holding "#", "&amp;", "+" or a space: the query
                     is cut short and the symbol then encodes a different value
                     than the one printed beside it. -->
                <span
                    t-out="doc.lot_id.name"
                    t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 600, 'height': 100, 'img_style': 'width:100%;height:22px'}"
                />
            </t>
        </xpath>
    </template>
</odoo>
