<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_analytic_account_view_form" model="ir.ui.view">
        <field
            name="name"
        >account.analytic.account.form (analytic_budget_number)</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form" />
        <field name="arch" type="xml">
            <!-- The attributes only mean something on an account of the
                 plan holding the budget numbers, so they are hidden elsewhere.
                 is_budget_account has to be materialised for the attrs to be
                 evaluated. -->
            <field name="plan_id" position="after">
                <field name="is_budget_account" invisible="1" />
                <field
                    name="satellite_id"
                    attrs="{'invisible': [('is_budget_account', '=', False)]}"
                />
                <field
                    name="subsystem_id"
                    attrs="{'invisible': [('is_budget_account', '=', False)]}"
                />
                <field
                    name="component_id"
                    attrs="{'invisible': [('is_budget_account', '=', False)]}"
                />
                <field
                    name="model_id"
                    attrs="{'invisible': [('is_budget_account', '=', False)]}"
                />
                <field
                    name="budget_description"
                    attrs="{'invisible': [('is_budget_account', '=', False)]}"
                />
            </field>
        </field>
    </record>
    <record id="account_analytic_account_view_tree" model="ir.ui.view">
        <field
            name="name"
        >account.analytic.account.tree (analytic_budget_number)</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_list" />
        <field name="arch" type="xml">
            <!-- The list is what an analytic account is looked up in, budget
                 numbers included, and there a budget number is recognised by
                 its name and its description. Everything else the list
                 holds stays a column away, rather than out of it for good.
                 The debit and the credit are columns of it for a user of the
                 accounting groups only: account makes the two visible and
                 restricts the fields themselves to those groups, which drops
                 them from the arch of anyone else. -->
            <field name="code" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="plan_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="debit" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="credit" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="balance" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="plan_id" position="after">
                <field name="satellite_id" optional="hide" />
                <field name="subsystem_id" optional="hide" />
                <field name="component_id" optional="hide" />
                <field name="model_id" optional="hide" />
                <field name="budget_description" optional="show" />
            </field>
        </field>
    </record>
    <record id="account_analytic_account_view_search" model="ir.ui.view">
        <field
            name="name"
        >account.analytic.account.search (analytic_budget_number)</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_search" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="satellite_id" />
                <field name="subsystem_id" />
                <field name="component_id" />
                <field name="model_id" />
            </field>
            <filter name="associatedpartner" position="after">
                <filter
                    string="Satellite"
                    name="groupby_satellite"
                    domain="[]"
                    context="{'group_by': 'satellite_id'}"
                />
                <filter
                    string="Subsystem"
                    name="groupby_subsystem"
                    domain="[]"
                    context="{'group_by': 'subsystem_id'}"
                />
                <filter
                    string="Component"
                    name="groupby_component"
                    domain="[]"
                    context="{'group_by': 'component_id'}"
                />
                <filter
                    string="Model"
                    name="groupby_model"
                    domain="[]"
                    context="{'group_by': 'model_id'}"
                />
            </filter>
        </field>
    </record>
</odoo>
