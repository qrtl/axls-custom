<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sep_val" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sep.val</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='default_accounts']" position="after">
                <h2>Separate Valuation Mode</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="sep_val_variance_account_id"/>
                            <div class="text-muted">
                                Account used to absorb the difference between the Final
                                Bill amount and the sum of paired advance credit notes.
                            </div>
                            <div class="content-group">
                                <div class="mt8">
                                    <field name="sep_val_variance_account_id"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
