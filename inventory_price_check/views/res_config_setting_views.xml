<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='warning_info']" position="after">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_right_pane">
                        <label for="price_discrepancy_threshold_type" />
                        <div class="text-muted">
                            Select the threshold type for displaying a warning message in case of a price discrepancy.
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field name="price_discrepancy_threshold_type" />
                            </div>
                        </div>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="price_discrepancy_threshold_value" />
                        <div class="text-muted">
                            Set the threshold value for detecting a price discrepancy.
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field name="price_discrepancy_threshold_value" />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
